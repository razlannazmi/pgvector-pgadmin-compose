# Per-machine config for setup-volume.sh / check-mount.sh.
# Copy this to volume.conf and edit — volume.conf is gitignored, so each
# machine can choose (and later switch) capped vs. uncapped storage
# independently of the others.
#
#   cp volume.conf.example volume.conf

# true  = size-capped loopback image mounted at MOUNT_POINT (default)
# false = use the plain host filesystem at MOUNT_POINT directly, no size limit
#
# Changing this after the volume already exists and re-running
# setup-volume.sh SWITCHES modes: it migrates whatever data is currently
# live into the new mode and keeps the old copy on disk as a backup. Stop
# the stack first: sudo docker compose down   (or: make down)
CAPPED=true

# HARD storage ceiling for Postgres — only used when CAPPED=true
CAP_SIZE=10G
